# Copy to .env (never commit .env) or set these in your hosting provider.
ANTHROPIC_API_KEY=
# Optional overrides
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
PORT=8787
# Optional: value the app sends as x-app-key (deters casual abuse only)
APP_SHARED_KEY=
# Set to 1 when running behind a reverse proxy/load balancer
TRUST_PROXY=0
RATE_BURST=5
RATE_PER_MINUTE=6
DAILY_CAP=2000
